# Server Configuration
PORT=5000
NODE_ENV=development
HOST=localhost
API_PREFIX=/api
BASE_URL=http://localhost:5000
APP_NAME=Tripwalaah

# MongoDB Configuration (same DB as Tripwalaah Node API)
MONGODB_URI=mongodb://localhost:27017/tripwalaah
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/tripwala?retryWrites=true&w=majority

# Database Connection Pool Configuration
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_CONNECT_TIMEOUT=30000
DB_SOCKET_TIMEOUT=45000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tripwala.vercel.app,https://tripwalaah.com
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:5173/
CORS_CREDENTIALS=true

# SignalR (live trip updates)
SIGNALR_ENABLED=true
# Hub endpoint: /hubs/trip
# Client events: MemberJoined, MemberLeft, LocationUpdated, TripStatusUpdated, PresenceSnapshot

# Redis (live locations cache) — same REDIS_URL style as Tripwalaah Node/BullMQ
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_LIVE_LOCATION_TTL_SECONDS=900
# Keys:
#   tripwalaah:live:{tripId}:{userId}
#   tripwalaah:live:trip:{tripId}

# Kafka (trip live events)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=tripwalaah-location-service
KAFKA_GROUP_ID=tripwalaah-location-service
KAFKA_LIVE_LOCATION_TOPIC=tripwalaah.trip.live-location
KAFKA_TRIP_EVENTS_TOPIC=tripwalaah.trip.events
# Set true to run the optional consumer hosted service
KAFKA_ENABLE_CONSUMER=false
