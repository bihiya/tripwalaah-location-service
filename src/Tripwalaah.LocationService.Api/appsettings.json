{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "APP_NAME": "Tripwalaah",
  "API_PREFIX": "/api",
  "PORT": "5000",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/tripwalaah",
    "DatabaseName": "tripwalaah",
    "LocationsCollectionName": "locations",
    "MaxPoolSize": 10,
    "MinPoolSize": 2,
    "ConnectTimeoutMs": 30000,
    "SocketTimeoutMs": 45000
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "tripwalaah",
    "LiveLocationTtlSeconds": 900
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "tripwalaah-location-service",
    "GroupId": "tripwalaah-location-service",
    "LiveLocationTopic": "tripwalaah.trip.live-location",
    "TripEventsTopic": "tripwalaah.trip.events",
    "EnableConsumer": false,
    "MessageTimeoutMs": 5000,
    "Acks": "all",
    "AllowAutoCreateTopics": true
  },
  "ConnectionStrings": {
    "MongoDb": "mongodb://localhost:27017/tripwalaah",
    "Redis": "localhost:6379"
  }
}
